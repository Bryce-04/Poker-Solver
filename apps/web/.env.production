# Loaded by Vite automatically for `vite build` (mode=production) --
# i.e. `pnpm --filter web build`, which is also the step `cap sync` runs
# against. Dev (`pnpm dev:web`) is unaffected and keeps defaulting to
# http://localhost:8000 (see lib/api.ts).
#
# Not secret -- it's a public URL -- so this is committed rather than left
# to each machine's .env.local.
VITE_API_BASE_URL=https://poker-solver-api.onrender.com
