# Copy to .env and fill in. Never commit the real .env.
#
# Local dev: leave DATABASE_URL as-is to use the docker-compose Postgres.
# Staging/shared dev: point these at the team's Supabase project instead
# (Project Settings -> API / Database in the Supabase dashboard).

DATABASE_URL=postgresql+psycopg://poker_solver:poker_solver_dev@localhost:5432/poker_solver

# apps/api needs SUPABASE_URL to verify sign-ins (its public JWKS keys --
# no secret involved). apps/web reads the URL + anon key from its own
# apps/web/.env.local, under VITE_ names -- see apps/web/.env.example.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

API_PORT=8000
SOLVER_PORT=8100

# apps/api: the Train tab's AI coach (Gemini's free tier). Unset = the coach is
# off and lessons show the app's own explanations. Get a key at Google AI Studio.
# GEMINI_MODEL is optional; set it to a current Flash model if the default is retired. It may be a
# comma-separated list, tried in order when one is busy (free tiers often are):
#   GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_API_KEY=
GEMINI_MODEL=
# The chat turns Gemini's silent "thinking" off (much faster). Set to `default` to leave it on, or
# a number of tokens to allow.
GEMINI_THINKING_BUDGET=0
# Optional limits: questions per user per hour, and across all users per day.
COACH_PER_HOUR=20
COACH_PER_DAY_TOTAL=800
